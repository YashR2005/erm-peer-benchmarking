F;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n12"><mxGeometry x="-0.5" relative="1" as="geometry" /></mxCell><mxCell id="e19" value="no: swap / add,&lt;br&gt;re-propose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#3A6FBD;fontColor=#3A6FBD;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="262" y="935" /><mxPoint x="262" y="803" /></Array></mxGeometry></mxCell><mxCell id="e20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="a1"><mxGeometry x="-0.5" relative="1" as="geometry" /></mxCell><mxCell id="e21" value="no: add or&lt;br&gt;mark n/a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#3A6FBD;fontColor=#3A6FBD;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="262" y="1349" /><mxPoint x="262" y="1075" /></Array></mxGeometry></mxCell><mxCell id="e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n24"><mxGeometry x="-0.5" relative="1" as="geometry" /></mxCell><mxCell id="e23" value="yes: re-review&lt;br&gt;that dimension" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#3A6FBD;fontColor=#3A6FBD;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="3273" /><mxPoint x="70" y="2669" /></Array></mxGeometry></mxCell><mxCell id="e24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n30"><mxGeometry x="-0.5" relative="1" as="geometry" /></mxCell><mxCell id="e25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n31"><mxGeometry x="-0.5" relative="1" as="geometry" /></mxCell><mxCell id="e26" value="re-check,&lt;br&gt;review again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#3A6FBD;fontColor=#3A6FBD;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n30" target="n28"><mxGeometry x="0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="262" y="3988" /><mxPoint x="262" y="3783" /></Array></mxGeometry></mxCell><mxCell id="a1" value="&lt;b&gt;A1 · Propose the client's risk list&lt;/b&gt;&lt;br&gt;from the profile (step 3) + the sector's typical risks (step 2)&lt;br&gt;each risk links to a sourced fact from step 3, e.g. &quot;operates in 6 countries&quot; [source, page] → foreign-exchange risk&lt;br&gt;plus consequence · segment / geography affected · labelled &quot;context-inferred&quot;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="1354" width="270" height="146" as="geometry" /></mxCell><mxCell id="a2" value="&lt;b&gt;A2 · Extract disclosed risks&lt;/b&gt; for client &lt;b&gt;and&lt;/b&gt; each peer&lt;br&gt;risk-factor sections: 10-K Item 1A · 20-F Item 3.D · annual report risk section&lt;br&gt;verbatim quote · document · page · company's own wording kept" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="1536" width="270" height="114" as="geometry" /></mxCell><mxCell id="a3" value="&lt;b&gt;A3 · Verify&lt;/b&gt;&lt;br&gt;quote must exist on cited page · entity boundary check (e.g. Alibaba group risk factors ≠ Lazada's own)&lt;br&gt;&lt;b&gt;rule:&lt;/b&gt; client has no standalone risk disclosure → client column = &quot;insufficient evidence&quot;, no client gaps reported" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="1686" width="270" height="130" as="geometry" /></mxCell><mxCell id="a4" value="&lt;b&gt;A4 · Map to a common risk taxonomy&lt;/b&gt;&lt;br&gt;default: strategic · financial · operational · compliance · people · technology · sustainability&lt;br&gt;label each risk: context-inferred · client-public · peer-public" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="1852" width="270" height="114" as="geometry" /></mxCell><mxCell id="a5" value="&lt;b&gt;A5 · Review risk list and mapping&lt;/b&gt;&lt;br&gt;accept · edit · remove · remap" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="15" y="2002" width="240" height="66" as="geometry" /></mxCell><mxCell id="a6" value="&lt;b&gt;A6 · Product A output&lt;/b&gt;&lt;br&gt;risk coverage matrix: each risk × client and peers, who discloses it&lt;br&gt;gaps, only where the client has its own disclosure: (1) relevant to client, not disclosed by it · (2) disclosed, missing from context · (3) peers disclose, client silent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E0F3E6;strokeColor=#2D8A52;" vertex="1" parent="lane_System"><mxGeometry x="15" y="2104" width="270" height="146" as="geometry" /></mxCell><mxCell id="adec" value="Continue to Product B?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="50" y="2404" width="170" height="78" as="geometry" /></mxCell><mxCell id="aend" value="" style="shape=doubleEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#16202B;strokeColor=#16202B;" vertex="1" parent="lane_System"><mxGeometry x="136" y="2429" width="28" height="28" as="geometry" /></mxCell><mxCell id="qa1" value="&lt;b&gt;Likelihood × impact ratings left out.&lt;/b&gt; The vision doc asks for a 5×5 matrix; Marsh's reviewer comment (BL2) says ratings would be arbitrary without client workshops." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="1392" width="310" height="70" as="geometry" /></mxCell><mxCell id="lqa1" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="qa1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="qa3" value="Same checks as step 8. For Lazada, Alibaba's risk factors are parent-level, so Lazada's column would read &quot;insufficient evidence&quot;, not a long list of gaps." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="1716" width="310" height="70" as="geometry" /></mxCell><mxCell id="lqa3" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="qa3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="qa4" value="&lt;b&gt;Q&lt;/b&gt; Use the 7 categories from the Client X appendix (shown) or the vision doc's 8 (workflow stage 3)? The doc's list has regulatory instead of compliance and human capital instead of people, adds climate and resilience, and has no sustainability." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="1859" width="310" height="100" as="geometry" /></mxCell><mxCell id="lqa4" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="qa4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="qa6" value="Gap types follow the vision doc (Product A). A gap means no public mention, not that the risk is unmanaged." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2150" width="310" height="54" as="geometry" /></mxCell><mxCell id="lqa6" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a6" target="qa6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="qad" value="&lt;b&gt;Q&lt;/b&gt; Is Product A delivered on its own before Product B, or only inside one combined report? If the Word summary goes to the client, should an ERM reviewer approve it, as in step 17? Confidential uploads left out: public data only." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2393" width="310" height="100" as="geometry" /></mxCell><mxCell id="lqad" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adec" target="qad"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hdrA" value="PRODUCT A · Risk profile benchmarking (A1–A7)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#6B4FA0;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="1342" width="310" height="24" as="geometry" /></mxCell><mxCell id="hdrB" value="PRODUCT B · ERM framework benchmarking (steps 7–18)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F7A6D;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2532" width="310" height="24" as="geometry" /></mxCell><mxCell id="boxA" value="" style="rounded=1;arcSize=1;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeWidth=1.5;pointerEvents=0;strokeColor=#6B4FA0;" vertex="1" parent="1"><mxGeometry x="4" y="1408" width="1462" height="1158" as="geometry" /></mxCell><mxCell id="boxB" value="" style="rounded=1;arcSize=1;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeWidth=1.5;pointerEvents=0;strokeColor=#1F7A6D;" vertex="1" parent="1"><mxGeometry x="4" y="2598" width="1462" height="1678" as="geometry" /></mxCell><mxCell id="ea1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea7" value="yes: Product B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adec" target="n15"><mxGeometry relative="1" as="geometry" x="-0.5" /></mxCell><mxCell id="ea8" value="no: Product A only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adec" target="aend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6b" value="&lt;b&gt;6b · Prepare documents&lt;/b&gt;&lt;br&gt;check right company · year · document type · extract text (OCR fallback for scans) · locate sections (e.g. Item 1A, Item 3.D)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="1106" width="270" height="98" as="geometry" /></mxCell><mxCell id="a7" value="&lt;b&gt;A7 · Export Product A&lt;/b&gt;&lt;br&gt;Excel risk coverage matrix (with quotes and pages) + short Word summary for consultants" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E0F3E6;strokeColor=#2D8A52;" vertex="1" parent="lane_System"><mxGeometry x="15" y="2286" width="270" height="82" as="geometry" /></mxCell><mxCell id="qa2" value="&lt;b&gt;Q&lt;/b&gt; Should Product A use the same peers as Product B, or direct competitors only? A disclosure-benchmark peer like Amazon has a very different risk profile from Lazada." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="1550" width="310" height="86" as="geometry" /></mxCell><mxCell id="lqa2" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="qa2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q9" value="&lt;b&gt;Q&lt;/b&gt; Rubric criteria: can we draft them from the demo's &quot;not publicly evident&quot; lists (e.g. formal risk appetite statement, quantified limits) for Marsh to confirm? Marsh's comment BL3 asks the team to propose the scoring metric." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2833" width="310" height="100" as="geometry" /></mxCell><mxCell id="lq9" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="q9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ep6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6b" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ea9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a7" target="adec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;Lanes show who does each step.&lt;br&gt;White = code · amber = AI (LLM) · blue = person · green = output&lt;br&gt;Diamonds = decisions · dashed blue arrows = loops&lt;br&gt;Red notes = questions for Marsh · grey notes = context&lt;br&gt;&lt;b&gt;Better than demo&lt;/b&gt; = improvement over Marsh's sample chat&lt;br&gt;Dashed purple box = Product A · dashed teal box = Product B · steps 1–6 are shared" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#9AA6B2;" vertex="1" parent="1"><mxGeometry x="0" y="4338" width="560" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>