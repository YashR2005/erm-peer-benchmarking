<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="wf" name="Workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="4518" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ERM Peer Benchmarking · Dynamic workflow (v1.2)&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Draft · 14 Oct 2026 · public data, live search · Product A (risk profile benchmarking, A1–A7) and Product B (ERM framework benchmarking, steps 7–18) share steps 1–6&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=18;fontStyle=1;fontColor=#16202B;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1470" height="60" as="geometry" /></mxCell><mxCell id="lane_Userconsultant" value="User (consultant)" style="swimlane;shape=swimlane;horizontal=1;startSize=30;html=1;fontStyle=1;fontSize=13;fontColor=#16202B;strokeColor=#9AA6B2;collapsible=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="270" height="4238" as="geometry" /></mxCell><mxCell id="lane_System" value="System" style="swimlane;shape=swimlane;horizontal=1;startSize=30;html=1;fontStyle=1;fontSize=13;fontColor=#16202B;strokeColor=#9AA6B2;collapsible=0;fillColor=#FBFCFD;swimlaneFillColor=#FBFCFD;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="300" height="4238" as="geometry" /></mxCell><mxCell id="lane_AILLM" value="AI (LLM)" style="swimlane;shape=swimlane;horizontal=1;startSize=30;html=1;fontStyle=1;fontSize=13;fontColor=#16202B;strokeColor=#9AA6B2;collapsible=0;fillColor=#FFF8E6;swimlaneFillColor=#FFF8E6;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="300" height="4238" as="geometry" /></mxCell><mxCell id="lane_ERMreviewer" value="ERM reviewer" style="swimlane;shape=swimlane;horizontal=1;startSize=30;html=1;fontStyle=1;fontSize=13;fontColor=#16202B;strokeColor=#9AA6B2;collapsible=0;fillColor=#E6EFFC;swimlaneFillColor=#E6EFFC;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="260" height="4238" as="geometry" /></mxCell><mxCell id="lane_QuestionsforMarshnotes" value="Questions for Marsh · notes" style="swimlane;shape=swimlane;horizontal=1;startSize=30;html=1;fontStyle=1;fontSize=13;fontColor=#16202B;strokeColor=#9AA6B2;collapsible=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="340" height="4238" as="geometry" /></mxCell><mxCell id="n1" value="" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#16202B;strokeColor=none;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="121" y="44" width="28" height="28" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;1 · Request&lt;/b&gt;&lt;br&gt;Client name + context: sector, focus regions, reporting year&lt;br&gt;peer type: direct competitors · disclosure benchmark · both&lt;br&gt;number of peers (default 3)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="15" y="108" width="240" height="114" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;2 · Load standard setup&lt;/b&gt; (versioned)&lt;br&gt;12-dimension rubric · sector search guide (regulators, exchanges, filing types, typical risks) · filing-section guide (10-K Items 1A, 1C, 9A · 20-F Items 3.D, 15, 16K) · report template" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="258" width="270" height="114" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;3 · Profile the client&lt;/b&gt; from live sources&lt;br&gt;business model · markets · group / ownership structure · scale · listing status · disclosure availability&lt;br&gt;every fact linked to its source" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="408" width="270" height="114" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;4 · Check profile&lt;/b&gt;&lt;br&gt;facts match their sources · flag group vs subsidiary boundary (e.g. Lazada inside Alibaba)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="558" width="270" height="82" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;5 · Propose peers&lt;/b&gt;&lt;br&gt;recommended set + alternatives · comparison table (model, markets, scale, listing) · why comparable / key limitation · linked-entity warnings · disclosure availability" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="676" width="270" height="114" as="geometry" /></mxCell><mxCell id="n10" value="Confirm peer set?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="50" y="826" width="170" height="78" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;6 · Find disclosure universe&lt;/b&gt; for client &lt;b&gt;and&lt;/b&gt; each peer&lt;br&gt;annual report / 10-K / 20-F · proxy &amp; governance · audit committee · cyber · sustainability · policies&lt;br&gt;record URL · date · period · file hash" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="940" width="270" height="130" as="geometry" /></mxCell><mxCell id="n14" value="Sources complete?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="50" y="1240" width="170" height="78" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;7 · Extract evidence by dimension&lt;/b&gt; (12 dimensions, one run per company)&lt;br&gt;verbatim quote · document · page · evidence type&lt;br&gt;&quot;not publicly evident&quot; items listed explicitly" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="2542" width="270" height="114" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b&gt;8 · Verify&lt;/b&gt;&lt;br&gt;quote must exist on cited page · entity boundary check (e.g. AWS customer material ≠ Amazon corporate ERM) · evidence state: found / none / insufficient" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="2692" width="270" height="114" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;9 · Answer rubric criteria&lt;/b&gt; per dimension&lt;br&gt;yes · no · partly · unclear, citing evidence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="2842" width="270" height="82" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b&gt;10 · Score&lt;/b&gt; 0–4 per dimension (code, from rubric rules)&lt;br&gt;+ confidence + evidence availability" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="2960" width="270" height="66" as="geometry" /></mxCell><mxCell id="n22" value="&lt;b&gt;11 · Review scores and evidence&lt;/b&gt;&lt;br&gt;confirm · override with reason · reject evidence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_ERMreviewer"><mxGeometry x="15" y="3062" width="230" height="66" as="geometry" /></mxCell><mxCell id="n23" value="Evidence rejected?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_ERMreviewer"><mxGeometry x="45" y="3164" width="170" height="78" as="geometry" /></mxCell><mxCell id="n24" value="&lt;b&gt;12 · Comparison&lt;/b&gt;&lt;br&gt;client vs each peer per dimension · strongest / weakest · comparability warnings (scale, geography, group reporting)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E0F3E6;strokeColor=#2D8A52;" vertex="1" parent="lane_System"><mxGeometry x="15" y="3278" width="270" height="98" as="geometry" /></mxCell><mxCell id="n25" value="&lt;b&gt;13 · Draft report&lt;/b&gt; in Marsh template&lt;br&gt;client profile · peer selection rationale · risk coverage and gaps (Product A, if run) · dimension-by-dimension findings · overall comparison · key findings · limitations · sources appendix · stops at findings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="3412" width="270" height="130" as="geometry" /></mxCell><mxCell id="n27" value="&lt;b&gt;14 · Claim checker&lt;/b&gt;&lt;br&gt;every factual sentence needs an evidence ID" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFFFFF;strokeColor=#4B5967;" vertex="1" parent="lane_System"><mxGeometry x="15" y="3578" width="270" height="66" as="geometry" /></mxCell><mxCell id="n28" value="&lt;b&gt;15 · Review draft&lt;/b&gt;, comment per section · consultant writes the remarks / recommendations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="15" y="3680" width="240" height="66" as="geometry" /></mxCell><mxCell id="n29" value="Changes needed?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_Userconsultant"><mxGeometry x="50" y="3782" width="170" height="78" as="geometry" /></mxCell><mxCell id="n30" value="&lt;b&gt;16 · Regenerate only that section&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#FFF3D1;strokeColor=#C99410;" vertex="1" parent="lane_AILLM"><mxGeometry x="15" y="3896" width="270" height="44" as="geometry" /></mxCell><mxCell id="n31" value="&lt;b&gt;17 · Final approval&lt;/b&gt; of client-facing wording" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E2EDFB;strokeColor=#3A6FBD;" vertex="1" parent="lane_ERMreviewer"><mxGeometry x="15" y="3976" width="230" height="50" as="geometry" /></mxCell><mxCell id="n32" value="&lt;b&gt;18 · Export&lt;/b&gt;&lt;br&gt;branded Word / PDF report + Excel evidence appendix" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fontColor=#16202B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fillColor=#E0F3E6;strokeColor=#2D8A52;" vertex="1" parent="lane_System"><mxGeometry x="15" y="4062" width="270" height="66" as="geometry" /></mxCell><mxCell id="n33" value="" style="shape=doubleEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#16202B;strokeColor=#16202B;" vertex="1" parent="lane_System"><mxGeometry x="136" y="4164" width="28" height="28" as="geometry" /></mxCell><mxCell id="q3" value="&lt;b&gt;Q&lt;/b&gt; Default peer count (demo used 3)? Can peers be global, or region-first? Who confirms peers: the consultant or an ERM reviewer?" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="130" width="310" height="70" as="geometry" /></mxCell><mxCell id="lq3" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q5" value="&lt;b&gt;Better than demo:&lt;/b&gt; same instructions and rubric every run, so two consultants get comparable output." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="280" width="310" height="70" as="geometry" /></mxCell><mxCell id="lq5" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="q5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q8" value="&lt;b&gt;Better than demo:&lt;/b&gt; demo profile had no sources. Boundary flag stops parent-company disclosures being credited to the client." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="564" width="310" height="70" as="geometry" /></mxCell><mxCell id="lq8" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="q8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q11" value="Kept from demo: alternatives and caveats (e.g. Tokopedia / TikTok Shop linked). Added: user chooses direct vs disclosure-oriented set explicitly." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="822" width="310" height="86" as="geometry" /></mxCell><mxCell id="lq11" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="q11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q13" value="&lt;b&gt;Better than demo:&lt;/b&gt; the client is reviewed with the same method (demo reviewed peers only)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="978" width="310" height="54" as="geometry" /></mxCell><mxCell id="lq13" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="q13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q16" value="&lt;b&gt;Q&lt;/b&gt; Which AI provider / web-search access is approved for live crawling? Any sources off-limits?" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2572" width="310" height="54" as="geometry" /></mxCell><mxCell id="lq16" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="q16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q18" value="&lt;b&gt;Better than demo:&lt;/b&gt; page-level citations and automatic checks; the AWS caveat the demo noted by hand becomes a rule." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2714" width="310" height="70" as="geometry" /></mxCell><mxCell id="lq18" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="q18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q21" value="&lt;b&gt;Better than demo:&lt;/b&gt; demo stopped before scoring. Scores come from rubric rules, not model judgment, so they are repeatable." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="2958" width="310" height="70" as="geometry" /></mxCell><mxCell id="lq21" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="q21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q26" value="&lt;b&gt;Q&lt;/b&gt; Can Marsh share 1–2 past reports to use as the template (headers, branding, tone)?" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#FFF1F1;strokeColor=#CF3434;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="3450" width="310" height="54" as="geometry" /></mxCell><mxCell id="lq26" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="q26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="q34" value="&lt;b&gt;Test plan&lt;/b&gt;: run on Lazada + 2–3 other clients; run each twice to check consistency of peers and scores; compare one run against a Marsh-reviewed answer." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;fontColor=#16202B;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#F3F6F9;strokeColor=#8794A1;" vertex="1" parent="lane_QuestionsforMarshnotes"><mxGeometry x="15" y="4052" width="310" height="86" as="geometry" /></mxCell><mxCell id="lq34" style="endArrow=none;dashed=1;html=1;strokeColor=#C9A0A0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="q34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6876;fontSize=11;fontColor=#16202B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relati