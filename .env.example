# Copy to .env and fill in. .env is git-ignored; never put a key in this file.

# Which model runs the AI stages. Only Claude Sonnet 5.5 (default) or Haiku 5.5 are allowed.
ERM_LLM_PROVIDER=anthropic
ERM_LLM_MODEL=claude-sonnet-5-5   # or claude-haiku-5-5

# Claude API key (from the Claude Console).
ANTHROPIC_API_KEY=

# OpenRouter: not allowed by the current setup (kept for later).
OPENROUTER_API_KEY=

# Sakana: not wired in.
SAKANA_API_KEY=
SAKANA_BASE_URL=https://api.sakana.ai
SAKANA_MODEL=fugu
