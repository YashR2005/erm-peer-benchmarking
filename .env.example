# Copy to .env and fill in. .env is git-ignored; never put a key in this file.

# Which model runs the AI stages: anthropic (Claude) or openrouter (default in setup/v1/method.yaml).
ERM_LLM_PROVIDER=anthropic
# ERM_LLM_MODEL=claude-opus-5-5

# Claude API key (from the Claude Console).
ANTHROPIC_API_KEY=

# OpenRouter: used only if ERM_LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Sakana: not wired in.
SAKANA_API_KEY=
SAKANA_BASE_URL=https://api.sakana.ai
SAKANA_MODEL=fugu
